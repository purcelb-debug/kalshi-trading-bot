# predlab configuration. Copy to .env and edit. .env is git-ignored. Never commit secrets.
# There are intentionally NO exchange/trading credential fields: this platform only reads public data.

# Historical (downloaded) data and simulated (paper) data are kept in separate databases.
PREDLAB_MARKET_DB_URL=sqlite:///data/market.db
PREDLAB_SIM_DB_URL=sqlite:///data/sim.db
# Optional PostgreSQL, e.g. postgresql+psycopg://user:pass@localhost:5432/predlab_market

PREDLAB_KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
PREDLAB_KALSHI_READS_PER_SEC=10

# Optional: free key from https://fred.stlouisfed.org/docs/api/api_key.html (econ collector skipped if empty)
PREDLAB_FRED_API_KEY=

# Optional: enables LLM fact extraction (Phase 5). Leave empty to disable.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Contact string sent as User-Agent to NOAA/NWS (they ask for one)
PREDLAB_USER_AGENT=predlab-research (contact: you@example.com)
PREDLAB_LOG_LEVEL=INFO
