# Copy to desk/.env (git-ignored) to override defaults. API keys go in the repository
# .env (ANTHROPIC_API_KEY, or GEMINI_API_KEY for Gemini), not here.
DESK_PROVIDER=claude
DESK_MODEL=claude-opus-5-5
DESK_SKEPTIC_MODEL=claude-opus-5-5
# Gemini instead: DESK_PROVIDER=gemini, DESK_MODEL=gemini-3.8-flash,
# DESK_SKEPTIC_MODEL=gemini-3.8-flash (Google Search grounding needs a paid-tier key)
DESK_EFFORT=medium
DESK_SKEPTIC_EFFORT=high
DESK_MAX_MEETINGS_PER_DAY=4
DESK_MAX_BUYS=3
DESK_SHRINK=0.5
DESK_QUANT_DEPLOYMENT=logistic_l2-57cdc200f7@KXHIGHNY-h30
