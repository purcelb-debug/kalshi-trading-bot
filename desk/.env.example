# Copy to desk/.env (git-ignored) to override defaults. API keys go in the repository
# .env (GEMINI_API_KEY and ANTHROPIC_API_KEY), not here.
# Scanner, Pricer, Risk and Desk Lead: no web search, so a free Gemini key is enough.
DESK_PROVIDER=gemini
DESK_MODEL=gemini-3.8-flash
# News Checker and Skeptic need web search: Claude.
DESK_SEARCH_PROVIDER=claude
DESK_SEARCH_MODEL=claude-opus-5-5
DESK_SKEPTIC_MODEL=claude-opus-5-5
# Cheaper News Checker: DESK_SEARCH_MODEL=claude-sonnet-5-5
DESK_EFFORT=medium
DESK_SKEPTIC_EFFORT=high
DESK_MAX_MEETINGS_PER_DAY=4
DESK_MAX_BUYS=3
DESK_SHRINK=0.5
DESK_QUANT_DEPLOYMENT=logistic_l2-57cdc200f7@KXHIGHNY-h30
