# Copy to executor/.env (git-ignored). Private-key FILES must live outside this repo,
# e.g. C:\Users\brend\.kalshi\demo.key  -- the executor refuses keys inside the project.
EXECUTOR_MODE=dry_run            # dry_run | demo | live

EXECUTOR_DEMO_KEY_ID=
EXECUTOR_DEMO_KEY_PATH=
EXECUTOR_LIVE_KEY_ID=
EXECUTOR_LIVE_KEY_PATH=

# REQUIRED before demo/live will run. No defaults on purpose. Dollars.
EXECUTOR_BANKROLL_CAP_USD=
EXECUTOR_MAX_ORDER_USD=
EXECUTOR_MIN_ORDER_USD=
EXECUTOR_DAILY_PROFIT_TARGET_USD=
EXECUTOR_DAILY_LOSS_STOP_USD=
# Optional per-market cap
EXECUTOR_MAX_MARKET_USD=

EXECUTOR_MAX_ORDERS_PER_DAY=20
EXECUTOR_MIN_EDGE=0.03
EXECUTOR_KELLY_FRACTION=0.25
EXECUTOR_SHRINK=0.5             # 1 = trust model fully, 0 = trust market fully
EXECUTOR_MIN_ENTRY_PRICE=0.05
EXECUTOR_MAX_ENTRY_PRICE=0.95
EXECUTOR_GATE_PAPER_WEEKS=4
# Live trading before the go-live gate opens (no validated edge). Leave blank unless you
# accept that risk; only the exact phrase I_ACCEPT_TRADING_AN_UNVALIDATED_STRATEGY works.
EXECUTOR_GATE_OVERRIDE=
EXECUTOR_ATTENDED=true           # live: confirm every order at the prompt
